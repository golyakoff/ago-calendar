<?xml version="1.0" encoding="utf-8"?>
<!--
  Local development only. Ago.Platform.* comes from the developer's own file feed
  (../ago-root/docs/runbooks/workspace.md); CI uses nuget.ci.config instead, which points at the
  real GitHub Packages feed (adr/0018). No credential lives in either file.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="ago-local" value="C:\git\ago\.nuget-feed" />
  </packageSources>
  <!-- Required with central package management once 2+ sources are configured (NU1507) - without
       it, NuGet cannot tell which source should serve a given package, and Directory.Build.props'
       TreatWarningsAsErrors turns that ambiguity into a hard restore failure. -->
  <packageSourceMapping>
    <packageSource key="ago-local">
      <package pattern="Ago.Platform.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
