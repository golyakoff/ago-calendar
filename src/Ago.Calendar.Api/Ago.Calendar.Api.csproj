<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Host: connections, commands, queries (adr/0013's split by failure profile). Ago.Platform.Hosting
    arrives transitively through Ago.Calendar.Module - a host composes the module, it does not
    duplicate the module's package list.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Ago.Calendar.Module\Ago.Calendar.Module.csproj" />
    <ProjectReference Include="..\Ago.Calendar.Contracts\Ago.Calendar.Contracts.csproj" />
  </ItemGroup>

  <!-- `20-06`: adr/0022's OIDC bearer validation. Not in the shared framework, so it is named here. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <!-- `25-63`: CalendarOperatorHub's own host-side wiring - ConnectionHeartbeat, NodeDeliveryConsumer,
       ConnectionDrainCoordinator and DrainHealthCheck are all resolved directly in this host's own
       Program.cs, the identical shape Ago.Chat.Api's Program.cs already uses for OperatorHub/
       VisitorHub. Arrives transitively through Ago.Calendar.Module too (AddConnectionRegistry), named
       here as well because Program.cs references these types by name, not only through DI. -->
  <ItemGroup>
    <PackageReference Include="Ago.Platform.Realtime" />
  </ItemGroup>

</Project>
