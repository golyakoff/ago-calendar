<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ago.Platform.Hosting carries IProductModule - the platform/product seam a host composes against.
    Caching.Redis / Storage.S3 are still not referenced here: this project needs neither until it has
    something to cache, and a reference with no call site would misrepresent what this product
    actually uses (Ago.Calendar.Infrastructure.Redis carries the one real Caching.Redis call site,
    IRateLimiter, and references it there instead).

    Messaging.RabbitMq joined `22-05`/`adr/0093` - RoleAssignmentsChangedConsumer
    (`Ago.Calendar.Worker`) is the first real call site, consuming a topic `ago-chat` publishes
    rather than one this product produces.

    Realtime joined `25-63` - AddConnectionRegistry, called from this file, wires
    CalendarOperatorHub's connection registry and cross-node fan-out (`Ago.Calendar.Api`) and the
    INodeFanoutPublisher its own worker-side resolve handler needs (`Ago.Calendar.Worker`).
  -->
  <ItemGroup Condition="'$(AgoCalendarDevOverride)' != 'true'">
    <PackageReference Include="Ago.Platform.Hosting" />
    <PackageReference Include="Ago.Platform.Messaging.RabbitMq" />
    <!-- `25-63`: AddConnectionRegistry, called from this file - CalendarOperatorHub's connection
         registry/scale-out. -->
    <PackageReference Include="Ago.Platform.Realtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(AgoCalendarDevOverride)' == 'true'">
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Hosting\Ago.Platform.Hosting.csproj" />
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Messaging.RabbitMq\Ago.Platform.Messaging.RabbitMq.csproj" />
    <ProjectReference Include="..\..\..\ago-platform\src\Ago.Platform.Realtime\Ago.Platform.Realtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ago.Calendar.Application\Ago.Calendar.Application.csproj" />
    <ProjectReference Include="..\Ago.Calendar.Infrastructure.Postgres\Ago.Calendar.Infrastructure.Postgres.csproj" />
    <!-- `20-02`: the tz-database adapter. Its own project rather than a class in
         Infrastructure.Postgres - see that project's .csproj for why. -->
    <ProjectReference Include="..\Ago.Calendar.Infrastructure.Time\Ago.Calendar.Infrastructure.Time.csproj" />
    <!-- `20-03`: the rate limiter behind the public booking endpoint. -->
    <ProjectReference Include="..\Ago.Calendar.Infrastructure.Redis\Ago.Calendar.Infrastructure.Redis.csproj" />
  </ItemGroup>

</Project>
