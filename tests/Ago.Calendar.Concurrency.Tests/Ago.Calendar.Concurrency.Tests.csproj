<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Separate from Ago.Calendar.Integration.Tests, matching Ago.Chat.Concurrency.Tests' precedent:
    these tests are about what happens when two writers are genuinely in flight at the same instant,
    which is a different question from "does the query work" and needs a different setup (several
    connections, deliberate interleaving, real parallelism rather than sequential awaits).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ago.Calendar.Infrastructure.Postgres\Ago.Calendar.Infrastructure.Postgres.csproj" />
    <ProjectReference Include="..\..\src\Ago.Calendar.Infrastructure.Time\Ago.Calendar.Infrastructure.Time.csproj" />
  </ItemGroup>

</Project>
