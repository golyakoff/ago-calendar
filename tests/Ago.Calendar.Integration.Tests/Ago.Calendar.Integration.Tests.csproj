<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ago.Calendar.Infrastructure.Postgres\Ago.Calendar.Infrastructure.Postgres.csproj" />
    <!-- `20-02`: the tz-database adapter. A test of it is an integration test by the same definition
         that put it in an Infrastructure project - the tz database is an external resource, and a
         fake of it would prove only that the fake behaves as its author expected. -->
    <ProjectReference Include="..\..\src\Ago.Calendar.Infrastructure.Time\Ago.Calendar.Infrastructure.Time.csproj" />
    <!-- `20-03`: the real host, so the booking endpoint's status codes and headers are proven over a
         real request rather than inferred from the handler's return value. -->
    <ProjectReference Include="..\..\src\Ago.Calendar.Api\Ago.Calendar.Api.csproj" />
    <!-- `20-20`: SchemaMigratorTests drives Ago.Calendar.Migrator's own MigratorRunner against a real
         Postgres - the same shape Ago.Chat.Integration.Tests.SchemaMigratorTests uses (`8-08`). -->
    <ProjectReference Include="..\..\src\Ago.Calendar.Migrator\Ago.Calendar.Migrator.csproj" />
    <!-- `ago-root#363`: ProvisionerTests drives Ago.Calendar.Provisioner's own ProvisionerRunner
         against a real Postgres - the identical shape SchemaMigratorTests already established one
         line above, for the sibling one-shot tool. -->
    <ProjectReference Include="..\..\src\Ago.Calendar.Provisioner\Ago.Calendar.Provisioner.csproj" />
  </ItemGroup>

</Project>
